  users_variant_price_history_created_byTousers User?            @relation("variant_price_history_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_vph_created_by")
  users_variant_price_history_updated_byTousers User?            @relation("variant_price_history_updated_byTousers", fields: [updated_by], references: [id], onUpdate: NoAction, map: "fk_vph_updated_by")

  @@index([variant_unit_price_id], map: "fk_vph_variant_unit_price")
  @@index([created_by], map: "fk_vph_created_by")
  @@index([updated_by], map: "fk_vph_updated_by")
  @@map("variant_price_history")
}

enum customer_addresses_address_type {
  shipping
  billing
}

model WhatsAppCampaign {
  id               BigInt                      @id @default(autoincrement()) @db.UnsignedBigInt
  uuid             String                      @default("UUID()") @db.VarChar(255)
  name             String                      @db.VarChar(255)
  description      String?                     @db.Text
  type             String                      @default("CUSTOM") @db.VarChar(100)
  status           String                      @default("DRAFT") @db.VarChar(50)
  message          String                      @db.Text
  media_url        String?                     @db.VarChar(500)
  scheduled_at     DateTime?                   @db.Timestamp(0)
  started_at       DateTime?                   @db.Timestamp(0)
  completed_at     DateTime?                   @db.Timestamp(0)
  total_recipients Int                         @default(0)
  sent_count       Int                         @default(0)
  failed_count     Int                         @default(0)
  created_at       DateTime                    @default(now()) @db.Timestamp(0)
  updated_at       DateTime                    @default(now()) @updatedAt @db.Timestamp(0)
  recipients       WhatsAppCampaignRecipient[]

  @@index([status], map: "idx_wac_status")
  @@map("whatsapp_campaigns")
}

model WhatsAppCampaignRecipient {
  id            BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  campaign_id   BigInt           @db.UnsignedBigInt
  customer_id   BigInt?          @db.UnsignedBigInt
  customer_name String?          @db.VarChar(255)
  phone_number  String           @db.VarChar(50)
  status        String           @default("QUEUED") @db.VarChar(50)
  error_message String?          @db.Text
  message_id    String?          @db.VarChar(100)
  sent_at       DateTime?        @db.Timestamp(0)
  created_at    DateTime         @default(now()) @db.Timestamp(0)
  updated_at    DateTime         @default(now()) @updatedAt @db.Timestamp(0)
  campaign      WhatsAppCampaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade, map: "fk_wacr_campaign")

  @@unique([campaign_id, phone_number], map: "uq_wacr_camp_phone")
  @@index([campaign_id, status], map: "idx_wacr_camp_status")
  @@map("whatsapp_campaign_recipients")
}

model WhatsAppTemplate {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name       String   @db.VarChar(255)
  category   String   @default("FESTIVAL") @db.VarChar(100)
  message    String   @db.Text
  media_url  String?  @db.VarChar(500)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(0)

  @@map("whatsapp_templates")
}
