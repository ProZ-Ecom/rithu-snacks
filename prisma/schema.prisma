generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Role {
  id                            BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  name                          String           @db.VarChar(100)
  slug                          String           @unique(map: "slug") @db.VarChar(100)
  description                   String?          @db.VarChar(255)
  createdAt                     DateTime         @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt                     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  is_active                     Boolean          @default(true)
  created_by                    BigInt?          @db.UnsignedBigInt
  updated_by                    BigInt?          @db.UnsignedBigInt
  rolePermissions               RolePermission[]
  users_roles_created_byTousers User?            @relation("roles_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_roles_created_by")
  users_roles_updated_byTousers User?            @relation("roles_updated_byTousers", fields: [updated_by], references: [id], onUpdate: NoAction, map: "fk_roles_updated_by")
  users                         User[]

  @@index([created_by], map: "fk_roles_created_by")
  @@index([updated_by], map: "fk_roles_updated_by")
  @@map("roles")
}

model Permission {
  id                                  BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  name                                String           @db.VarChar(150)
  slug                                String           @unique(map: "slug") @db.VarChar(150)
  module                              String           @db.VarChar(100)
  createdAt                           DateTime         @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt                           DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  is_active                           Boolean          @default(true)
  created_by                          BigInt?          @db.UnsignedBigInt
  updated_by                          BigInt?          @db.UnsignedBigInt
  users_permissions_created_byTousers User?            @relation("permissions_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_permissions_created_by")
  users_permissions_updated_byTousers User?            @relation("permissions_updated_byTousers", fields: [updated_by], references: [id], onUpdate: NoAction, map: "fk_permissions_updated_by")
  rolePermissions                     RolePermission[]

  @@index([created_by], map: "fk_permissions_created_by")
  @@index([updated_by], map: "fk_permissions_updated_by")
  @@map("permissions")
}

model RolePermission {
  id                                       BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  roleId                                   BigInt     @map("role_id") @db.UnsignedBigInt
  permissionId                             BigInt     @map("permission_id") @db.UnsignedBigInt
  createdAt                                DateTime   @default(now()) @map("created_at") @db.Timestamp(0)
  updated_at                               DateTime   @default(now()) @db.Timestamp(0)
  is_active                                Boolean    @default(true)
  created_by                               BigInt?    @db.UnsignedBigInt
  updated_by                               BigInt?    @db.UnsignedBigInt
  users_role_permissions_created_byTousers User?      @relation("role_permissions_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_role_permissions_created_by")
  users_role_permissions_updated_byTousers User?      @relation("role_permissions_updated_byTousers", fields: [updated_by], references: [id], onUpdate: NoAction, map: "fk_role_permissions_updated_by")
  permission                               Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_rp_permission")
  role                                     Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_rp_role")

  @@unique([roleId, permissionId], map: "uq_role_permission")
  @@index([created_by], map: "fk_role_permissions_created_by")
  @@index([updated_by], map: "fk_role_permissions_updated_by")
  @@index([permissionId], map: "fk_rp_permission")
  @@map("role_permissions")
}

